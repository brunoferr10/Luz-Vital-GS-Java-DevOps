{
  "info": {
    "name": "Luz Vital · CRUD em nuvem",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute manualmente uma requisição por vez. Após cada POST/PUT/DELETE, rode SELECT no Azure SQL. Configure ambiente e credenciais; não compartilhe ambiente preenchido. Antes de repetir o ciclo, limpe inicio e idempotencyKey. Use IA antes da exclusão dos dados."
  },
  "item": [
    {
      "name": "CRUD completo · alternar com SELECT no SQL",
      "item": [
        {
          "name": "01 Login gestor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{gestorEmail}}\",\n  \"senha\": \"{{gestorSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));",
                  "if(pm.response.code < 300) pm.environment.set('tokenGestor',pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
