        {
          "name": "11 Abrir ocorrência + SELECT ocorrencias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ocorrencias",
            "auth": {
              "type": "bearer",
