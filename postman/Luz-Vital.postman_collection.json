              "mode": "raw",
              "raw": "{\n  \"pacienteId\": \"{{pacienteId}}\",\n  \"inicio\": \"{{inicio}}\",\n  \"observacao\": \"Falta de energia fictícia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('inicio')) pm.environment.set('inicio',new Date().toISOString());",
                  "if (!pm.environment.get('idempotencyKey')) pm.environment.set('idempotencyKey',pm.variables.replaceIn('{{$guid}}')); "
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));",
